    {
      "name": "KPI Feedback Actions",
      "description": "Feedback and remediation APIs. Run Create feedback action first; its test script stores the generated ID in feedbackActionId.",
      "item": [
        {
          "name": "Create feedback action",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('feedbackActionId', pm.response.json().data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kpiMeasurementId\": {{kpiMeasurementId}},\n  \"rootCauseSummary\": \"Release validation did not cover the affected regression scenario.\",\n  \"linkedJiraIssueKey\": \"KPI-101\",\n  \"submittedBy\": {{submittedBy}},\n  \"jiraStatusSnapshot\": \"In Progress\",\n  \"verificationResult\": \"pending\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/kpi-feedback-actions"
          }
        },
        {
          "name": "List feedback actions",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/kpi-feedback-actions" }
        },
        {
          "name": "List actions by source measurement",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/kpi-feedback-actions?kpiMeasurementId={{kpiMeasurementId}}" }
