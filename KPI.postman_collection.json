{
  "info": {
    "name": "KPI Management API",
    "_postman_id": "kpi-management-api-v2",
    "description": "API collection for KPI Management System.\n\nBase URL: http://localhost:8080/kpi\n\nAll endpoints (except Login) require a Bearer JWT token. After Login the token is automatically saved to the `token` collection variable and attached to every request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/kpi",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "kpiMeasurementId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "verificationMeasurementId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "submittedBy",
      "value": "1",
      "type": "string"
    },
    {
      "key": "feedbackActionId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    pm.collectionVariables.set('token', res.token);",
                  "    console.log('Token saved:', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@kpi.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticate and receive a JWT token. Token is automatically saved to the `token` collection variable and used in all subsequent requests. Token expiry: 24 hours."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzI1NiJ9...\",\n  \"email\": \"admin@kpi.com\",\n  \"role\": \"admin\",\n  \"name\": \"Admin User\",\n  \"employeeId\": 1\n}"
            },
            {
              "name": "401 Invalid Credentials",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"message\": \"Invalid email or password\",\n  \"timestamp\": \"2026-06-13T10:00:00\"\n}"
            }
          ]
        }
      ]
    },
